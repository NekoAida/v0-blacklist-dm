generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id          String   @id @default(uuid())
  dmName      String
  facebook    String?
  discord     String?
  reason      String
  categories  String[]
  evidenceUrl String?
  createdAt   DateTime @default(now())
}
